# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Generated datasets, checkpoints, job logs, rendered figures, and eval CSVs
data/
checkpoints/
logs/
evaluation/figures/
results/

# Exception: report/data/exp16/ is a tracked report deliverable (per
# docs/exp16_data_request.md), not a generated dataset dir like the rest of data/.
!report/data/
!report/data/**

# Local CPU venv (eval only)
.venv/

# Superpowers working docs (plans/brainstorms — local only)
docs/superpowers/

# LaTeX build intermediates (keep .tex and .pdf) + editor swap files
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.swp

# Rendered presentation decks (regenerate from the .md source)
presentation/*.html
presentation/*.pptx
